# ---------------------------------------------------------------- Supabase
# Project Settings -> Data API.
NEXT_PUBLIC_SUPABASE_URL=

# The public, RLS-constrained key. Supabase renamed this: new projects issue a
# *publishable* key (sb_publishable_...), older ones an *anon* key (a JWT).
# Set whichever your project shows -- the app accepts either and prefers the
# publishable one. Safe to expose; it grants only what the policies in
# supabase/schema.sql allow.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings -> Database -> Connection string -> URI.
# Used by `npm run db:push`, `db:seed` and `db:reset`.
# The password may contain / ? # -- paste it exactly as shown, no escaping
# needed; the scripts parse it without going through a URL parser.
SUPABASE_DB_URL=

# OPTIONAL. Project Settings -> API Keys -> service_role (or sb_secret_...).
# Bypasses every RLS policy, so it is read only in server-side code and never
# reaches the browser. Nothing needs it to get running -- the seed script goes
# through SUPABASE_DB_URL instead. It only enables deleting an account outright
# from the admin panel, which requires the Auth Admin API.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------- seed accounts
# Credentials `npm run db:seed` creates. Test fixtures for local development --
# change them before pointing this at anything reachable from the internet.
SEED_ADMIN_EMAIL=admin@nb-make.test
SEED_ADMIN_PASSWORD=nbmake-admin-2026
SEED_USER_EMAIL=user@nb-make.test
SEED_USER_PASSWORD=nbmake-user-2026
